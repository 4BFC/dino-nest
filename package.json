{
  "name": "docnest",
  "description": "A Docusaurus starter template for personal knowledge and project documentation.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "DOCUSAURUS_GENERATED_FILES_DIR_NAME=.docusaurus-dev docusaurus start",
    "build": "pnpm lint && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "lint": "pnpm lint:js && pnpm lint:css",
    "lint:js": "eslint \"*.js\" \"src/**/*.{js,jsx}\" --max-warnings 0",
    "lint:js:fix": "pnpm lint:js --fix",
    "lint:css": "stylelint \"src/**/*.{css,scss}\" --max-warnings 0",
    "lint:css:fix": "pnpm lint:css --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,scss,json}\" \"*.{js,json}\" \".vscode/*.json\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,scss,json}\" \"*.{js,json}\" \".vscode/*.json\"",
    "agentation": "agentation-mcp server",
    "agentation:doctor": "agentation-mcp doctor"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/plugin-client-redirects": "3.10.1",
    "@docusaurus/plugin-content-docs": "3.10.1",
    "@docusaurus/plugin-pwa": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@docusaurus/theme-common": "3.10.1",
    "@docusaurus/theme-mermaid": "3.10.1",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "docusaurus-plugin-sass": "^0.2.7",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.106.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@eslint/js": "10.0.1",
    "agentation": "^3.1.2",
    "agentation-mcp": "^1.3.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "^17.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "license": "MIT",
  "author": "4BFC",
  "repository": {
    "type": "git",
    "url": "https://github.com/4BFC/docnest.git"
  }
}
